{
  "schema_version": 1,
  "repository": {
    "root": "<ROOT>",
    "github_owner": "acme",
    "github_repository": "polyglot",
    "release_workflow": "publish.yml"
  },
  "packages": [
    {
      "registry": "npm",
      "name": "@acme/widgets",
      "version": "1.2.3",
      "manifest": "package.json",
      "publishable": true,
      "publishing_policy": "oidc-only",
      "workflow": "publish.yml",
      "workflow_jobs": [
        "publish"
      ],
      "warnings": [
        "publishing authentication is oidc-only; migrate to OIDC with token fallback"
      ]
    },
    {
      "registry": "crates-io",
      "name": "acme-widgets",
      "version": "1.2.3",
      "manifest": "rust/Cargo.toml",
      "publishable": true,
      "warnings": [
        "no workflow publishes acme-widgets to crates-io; CI releases will not reach it"
      ]
    },
    {
      "registry": "pypi",
      "name": "acme-widgets",
      "version": "1.2.3",
      "manifest": "python/pyproject.toml",
      "publishable": true,
      "warnings": [
        "no workflow publishes acme-widgets to pypi; CI releases will not reach it"
      ]
    },
    {
      "registry": "go-modules",
      "name": "github.com/acme/widgets",
      "version": null,
      "manifest": "go/go.mod",
      "publishable": true
    },
    {
      "registry": "nuget",
      "name": "Acme.Widgets",
      "version": "1.2.3",
      "manifest": "dotnet/Widgets.csproj",
      "publishable": true,
      "warnings": [
        "no workflow publishes Acme.Widgets to nuget; CI releases will not reach it"
      ]
    },
    {
      "registry": "maven-central",
      "name": "com.acme:widgets",
      "version": "1.2.3",
      "manifest": "java/pom.xml",
      "publishable": true,
      "credential_requirements": {
        "oidc": "unsupported",
        "oidc_note": "Sonatype Central Portal has no OIDC trusted publishing; publish with a Central user-token pair and a GPG signing key.",
        "namespace": "verified Central Portal namespace matching the groupId",
        "storage": "memory-or-encrypted-github-secret",
        "secrets": [
          {
            "role": "central-username",
            "secret": "CENTRAL_USERNAME",
            "referenced": false
          },
          {
            "role": "central-token",
            "secret": "CENTRAL_TOKEN",
            "referenced": false
          },
          {
            "role": "gpg-private-key",
            "secret": "GPG_PRIVATE_KEY",
            "referenced": false
          },
          {
            "role": "gpg-passphrase",
            "secret": "GPG_PASSPHRASE",
            "referenced": false
          }
        ]
      },
      "warnings": [
        "no workflow publishes com.acme:widgets to maven-central; CI releases will not reach it"
      ]
    },
    {
      "registry": "packagist",
      "name": "acme/widgets",
      "version": "1.2.3",
      "manifest": "php/composer.json",
      "publishable": true,
      "credential_requirements": {
        "oidc": "unsupported",
        "oidc_note": "Public packagist.org has no OIDC publishing (Private Packagist OIDC is a separate product); releases come from tags via the GitHub hook or the update-package API.",
        "storage": "memory-or-encrypted-github-secret",
        "secrets": [
          {
            "role": "packagist-username",
            "secret": "PACKAGIST_USERNAME",
            "referenced": false,
            "optional": true
          },
          {
            "role": "packagist-api-token",
            "secret": "PACKAGIST_TOKEN",
            "referenced": false,
            "optional": true
          }
        ]
      }
    },
    {
      "registry": "docker-hub",
      "name": "acme/widgets",
      "version": null,
      "manifest": "Dockerfile",
      "publishable": true,
      "workflow": "container.yml"
    },
    {
      "registry": "ghcr",
      "name": "acme/polyglot",
      "version": null,
      "manifest": "Dockerfile",
      "publishable": true,
      "workflow": "container.yml"
    }
  ]
}
