{
  "schema_version": 1,
  "repository": {
    "root": "<ROOT>",
    "github_owner": "acme",
    "github_repository": "pipeline-app",
    "release_workflow": "release.yml"
  },
  "packages": [
    {
      "registry": "npm",
      "name": "pipeline-app",
      "version": "0.1.0",
      "manifest": "package.json",
      "publishable": true,
      "workflow": "release.yml",
      "workflow_jobs": [
        "npm"
      ]
    },
    {
      "registry": "docker-hub",
      "name": "acme/pipeline-app",
      "version": null,
      "manifest": "Dockerfile",
      "publishable": true,
      "workflow": "release.yml",
      "token_secrets": [
        "DOCKERHUB_TOKEN"
      ]
    },
    {
      "registry": "ghcr",
      "name": "acme/pipeline-app",
      "version": null,
      "manifest": "Dockerfile",
      "publishable": true,
      "workflow": "release.yml"
    }
  ]
}
